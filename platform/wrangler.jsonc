{
  "name": "techouse",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-30",
  "triggers": { "crons": ["0 4 * * *"] },
  "assets": { "directory": "../site", "binding": "ASSETS", "run_worker_first": true },
  "d1_databases": [{ "binding": "DB", "database_name": "techouse", "database_id": "REPLACE_WITH_CREATED_D1_DATABASE_ID", "migrations_dir": "migrations" }],
  "vars": { "APP_ORIGIN": "https://REPLACE_WITH_APPROVED_DOMAIN", "COOKIE_SECURE": "true" }
}
