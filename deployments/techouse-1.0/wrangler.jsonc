{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "techouse",
  "main": "worker-entry.mjs",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "../../site",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "techouse",
      "database_id": "186b525d-4f1c-4f8b-87f0-d83df59355f7",
      "migrations_dir": "../../platform/migrations"
    }
  ],
  "vars": {
    "APP_ORIGIN": "https://techouse.johndavidceasar.workers.dev",
    "COOKIE_SECURE": "true"
  },
  "triggers": {
    "crons": [
      "0 4 * * *"
    ]
  },
  "account_id": "e10eecc148c8ccc7a82cecd6c9a58fc6",
  "build": {
    "command": "node refresh-assets.mjs",
    "cwd": "."
  }
}
