{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "techouse-cleaned",
  "main": "cleaned-demo.mjs",
  "compatibility_date": "2026-10-30",
  "workers_dev": true,
  "preview_urls": false,
  "account_id": "e10eecc148c8ccc7a82cecd6c9a58fc6",
  "assets": {
    "directory": "../../site",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "build": { "command": "node refresh-assets.mjs", "cwd": "." }
}
